# Port the Express server listens on
PORT=3000

# Clients must send this as `x-api-key` (or `Authorization: Bearer ...`). Min 16 chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=

# Set Naukri and/or NaukriGulf credentials (at least one service required).
# Naukri account (single user)
NAUKRI_USERNAME=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# Optional outbound proxy, e.g. http://user:pass@host:port or socks5://host:port
# Naukri flags most cloud/datacenter IPs; a residential proxy helps when hosting in the cloud.
NAUKRI_PROXY=

# NaukriGulf account: enables the /api/gulf/* routes (reuses NAUKRI_PROXY)
NAUKRIGULF_USERNAME=
NAUKRIGULF_PASSWORD=
