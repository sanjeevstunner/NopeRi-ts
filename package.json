{
  "name": "noperi-ts",
  "version": "1.0.0",
  "description": "Naukri.com API client with an Express REST interface",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "httpcloak": "^1.7.3",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "typescript": "5.9"
  }
}
